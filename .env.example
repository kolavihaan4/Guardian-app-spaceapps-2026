# ─────────────────────────────────────────────────────────────────────────────
# AstroVitals environment template. Copy to `.env` (never commit `.env`).
# Every value here is read ONLY by the Node backend (apps/server). Nothing in this
# file is ever bundled into the browser app.
# ─────────────────────────────────────────────────────────────────────────────

# --- Server -------------------------------------------------------------------
NODE_ENV=development
PORT=8787
# Public origin of the web app (used for CORS allow-list, cookie flags, OAuth redirects)
APP_ORIGIN=http://localhost:5173
# Where SQLite lives. Created on first start. Holds encrypted tokens + health data.
DATABASE_PATH=./data/astrovitals.sqlite
# Behind a TLS-terminating proxy in production? Set to 1 so secure cookies work.
TRUST_PROXY=0

# --- Secrets (REQUIRED) ---------------------------------------------------------
# 32 random bytes, base64. Generate with:  npm run gen:key
# Encrypts OAuth access/refresh tokens at rest (AES-256-GCM). Losing it = users must reconnect.
TOKEN_ENCRYPTION_KEY=
# 32 random bytes, base64. HMAC key used to hash companion-app device
# tokens before they are stored (a DB leak alone cannot replay them). npm run gen:key
DEVICE_TOKEN_PEPPER=

# --- Privacy ------------------------------------------------------------------
# Wearable measurements older than this are deleted automatically (hourly job).
RETENTION_DAYS=90

# --- Sign-in (Supabase Auth) -------------------------------------------------
# The server checks each request's Supabase access token by asking this project who it belongs to.
# Use the PUBLISHABLE key (sb_publishable_...), which is public by design. Never a secret/service_role key.
SUPABASE_URL=https://azeehmngjcnpqtjoofzs.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_6A3puluLFzqez8yu3TdzIg_uaFZDVJX

# --- NASA ---------------------------------------------------------------------
# Get a free key at https://api.nasa.gov/ (DEMO_KEY is heavily rate-limited: observed
# X-RateLimit-Limit: 10 per IP on 2026-10-05). Only the legacy APOD fallback uses it;
# DONKI, EONET, POWER and the new APOD endpoint are keyless.
NASA_API_KEY=DEMO_KEY
# DONKI moved in Sept 2026 (CCMC notice https://ccmc.gsfc.nasa.gov/news/major-updates/).
NASA_DONKI_BASE=https://ccmc.gsfc.nasa.gov/DONKI-API/get
NASA_EONET_BASE=https://eonet.gsfc.nasa.gov/api/v3
NASA_POWER_BASE=https://power.larc.nasa.gov/api/temporal
NASA_APOD_BASE=https://science.nasa.gov/wp-json/wp/v2/apod-basic
NASA_APOD_LEGACY_BASE=https://api.nasa.gov/planetary/apod
NOAA_SWPC_BASE=https://services.swpc.noaa.gov
# Default location for the POWER environment panel (Johnson Space Center, Houston)
DEFAULT_LATITUDE=29.5502
DEFAULT_LONGITUDE=-95.0970

# --- Google Health API (Fitbit / Pixel Watch data) --------------------------------
# Replaces the Fitbit Web API, which is turned off on 2026-10-30.
# NOTE (2026-10-05): Google "is not onboarding new projects at this time"
# (https://developers.google.com/health/setup). Leave blank unless your Cloud project
# already has access. Create a "Web application" OAuth client; add the redirect URI below.
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
GOOGLE_HEALTH_REDIRECT_URI=http://localhost:8787/api/providers/google-health/callback

# --- Garmin Health API (approval-only; leave blank) -------------------------------
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=

# --- Logging ------------------------------------------------------------------
# Logs never contain request bodies, query strings, tokens or health values.
LOG_LEVEL=info
