          "protocols": [
            {
              "@id": "#139758652111696",
              "comments": [],
              "components": [],
              "description": "Bacterial infections with E. coli ATCC 25922 were as previously described. A single spore isolate of Beauveria bassiana (strain GHA) was cultured on Sabouraud dextrose agar. Conidia and hyphae were harvested by passing culture through a sterile ASTM No. 100 sieve. Spores were also flown on the space shuttle and we are happy to provide information upon request. Natural infection by B. bassiana used a dosage of 9.5x10^6 spores/fly, with procedures and survival assays as previously described. Ten replicates of 20 flies each for all strains were used in all 3 experiments for the CARU hypergravity tests. The centrifuge was stopped once per day to conduct survival counts. Control survival assays after bacterial and fungal infections on wild-type, hemolectin-Gal4; UAS-GFP, imd1, imdEY08573 and spz4 were conducted at Kennedy Space Center to establish that space and Earth fly infections were proceeding in accordance with our standardized conditions.",
              "name": "treatment protocol",
              "parameters": [
                {
                  "@id": "#139758267397840",
                  "parameterName": {
                    "@id": "3Hq6ViAPdhnUQVpmPN4g5qe1Sc2CIbQALaTc3jdF",
                    "annotationValue": "",
                    "comments": [],
                    "termAccession": "",
                    "termSource": ""
                  }
                }
              ],
              "protocolType": {
                "@id": "LqPqGCGqW30U95npRFwaWKYfnnu3IhQtYDZrgkQE",
